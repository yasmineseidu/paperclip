# ===========================================
# Paperclip Railway Environment Variables
# ===========================================
# Copy these into Railway's "Variables" tab.
# Railway auto-injects DATABASE_URL and PORT
# when you add a Postgres addon.
# ===========================================

# DATABASE -- Railway injects this automatically
# when you add a PostgreSQL service and link it.
# You do NOT need to set this manually.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# PORT -- Railway injects this automatically.
# Paperclip reads it from the PORT env var.
# You do NOT need to set this manually.
# PORT=3000

# HOST -- Must be 0.0.0.0 so Railway can route traffic
HOST=0.0.0.0

# DEPLOYMENT MODE -- "authenticated" requires login
# "local_trusted" skips auth (NEVER use on public server)
PAPERCLIP_DEPLOYMENT_MODE=authenticated

# PUBLIC URL -- Set this to your Railway-generated URL
# Example: https://paperclip-production-abc123.up.railway.app
# Required for auth callbacks to work correctly
PAPERCLIP_PUBLIC_URL=https://your-app.up.railway.app

# JWT SECRET -- Generate a random string for agent auth tokens
# Run: openssl rand -hex 32
PAPERCLIP_AGENT_JWT_SECRET=your-random-secret-here

# STORAGE -- Use S3-compatible storage for file uploads
# Railway volumes work too, but S3 is more reliable
# Options: "local_disk" or "s3"
PAPERCLIP_STORAGE_PROVIDER=local_disk

# If using S3 (recommended for production):
# PAPERCLIP_STORAGE_PROVIDER=s3
# PAPERCLIP_STORAGE_S3_BUCKET=your-bucket
# PAPERCLIP_STORAGE_S3_REGION=us-east-1

# SECRETS PROVIDER -- How agent secrets are encrypted
# "local_encrypted" needs a persistent master key file
# Make sure your Railway volume mounts ~/.paperclip/
PAPERCLIP_SECRETS_PROVIDER=local_encrypted

# DATABASE BACKUPS -- Disable if using Railway's managed backups
PAPERCLIP_DB_BACKUP_ENABLED=false

# AUTH -- Disable public signups if you want invite-only
# PAPERCLIP_AUTH_DISABLE_SIGN_UP=true
